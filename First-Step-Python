# ==========================================
# 1. Padronização de Texto
# ==========================================
df["name"] = df["name"].astype(str).str.lower()
df["username"] = (
    df["username"]
    .astype(str)
    .str.lower()
    .str.replace(".", "_", regex=False)
)
df["email"] = df["email"].astype(str).str.lower()
df["phone"] = (
    df["phone"]
    .astype(str)
    .str.replace(" ", "", regex=False)
    .str.replace(".", "-", regex=False)
    .str.replace("x", "-", regex=False)
)

# ==========================================
# 2. Expansão Segura dos JSONs (Address & Company)
# ==========================================
# Trata 'address' se ainda existir no df
if "address" in df.columns:
    address_df = pd.json_normalize(df["address"])
    df = pd.concat([df.drop(columns=["address"]), address_df], axis=1)

# Trata 'company' se ainda existir no df
if "company" in df.columns:
    company_df = pd.json_normalize(df["company"]).rename(
        columns={
            "name": "company_name",
            "catchPhrase": "company_catch_phrase",
            "bs": "company_bs",
        }
    )
    df = pd.concat([df.drop(columns=["company"]), company_df], axis=1)

